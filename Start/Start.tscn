[sub_resource type="GDScript" id="GDScript_gx2gx"]
resource_name = "Main"
script/source = "extends ColorRect

func _ready():
	for i in OS.get_cmdline_args():
		if i.ends_with(\".bpu\"):
			get_tree().change_scene_to_file(\"res://Lang-ASM/ASM.tscn\")
		if i.ends_with(\".bpux\"):
			get_tree().change_scene_to_file(\"res://Lang-ASM/ASM.tscn\")
		if i.ends_with(\".qb\"):
			get_tree().change_scene_to_file(\"res://Lang-QB/QB.tscn\")
"

[sub_resource type="GDScript" id="GDScript_52bhu"]
